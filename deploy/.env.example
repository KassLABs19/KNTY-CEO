# Fill these in and save as deploy/.env (never share or commit that file).
# Generate long random values, for example: openssl rand -base64 48
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET=
# production or staging. A staging server must use its own partner secrets.
APP_ENV=production
# Supplied by the vendor together with licence.json
LICENCE_PUBLIC_KEY=
