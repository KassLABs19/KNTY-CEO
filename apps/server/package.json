{
  "name": "@ceo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "licence:keys": "tsx scripts/licence.ts keys",
    "licence:sign": "tsx scripts/licence.ts sign",
    "test": "vitest run",
    "setup:company": "tsx scripts/setup-company.ts",
    "send:test": "tsx scripts/send-test-message.ts"
  },
  "dependencies": {
    "@ceo/shared": "0.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
