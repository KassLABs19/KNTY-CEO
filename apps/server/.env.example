# Copy this file to .env and fill in the values.

# PostgreSQL connection. The app user must NOT be a superuser (see docs/SETUP.md).
DATABASE_URL=postgres://ceo_app:change-me@localhost:5432/knty_ceo

# Long random string used to sign sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# production, staging or development. Staging shows a banner in the app.
# Staging must use its own partner secrets and partner addresses (see docs/INTEGRATION.md).
APP_ENV=development

# cloud = you host it for many companies; self = installed on one customer's server
HOSTING_MODE=cloud

# Lowest desktop app version the server accepts. Raise it to force everyone to update.
MIN_DESKTOP_VERSION=0.1.0

PORT=8090
# Web addresses allowed to call the API during development (comma-separated)
CORS_ORIGINS=http://localhost:5175

# Security settings
LOCK_AFTER_FAILED_ATTEMPTS=5
LOGIN_RATE_LIMIT=10
SIGN_OUT_AFTER_IDLE_MINUTES=30
REAUTH_MINUTES=5
INVITE_HOURS=48

# Background jobs: outbox delivery every 30 s, reminders and escalation every 15 min.
RUN_JOBS=on

# Only for HOSTING_MODE=self: path to the customer's licence file and the vendor public key (base64).
LICENCE_PATH=./licence.json
LICENCE_PUBLIC_KEY=
